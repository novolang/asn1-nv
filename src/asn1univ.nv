// asn1univ — the universal types, read out of a document by offset.
//
// Every reader takes an offset and answers a value: `integer_at(src,
// off, limits)` reads the tag-length-value at `off`, checks that it is
// an INTEGER, and answers the number.  A string comes back as a `Str`,
// and the other contents as `Bytes` copied out of the document.
//
// An INTEGER has two readers.  A certificate's serial number is up to
// twenty bytes and an RSA modulus 257, and neither fits an `Int`.
// `integer_at` answers a number when it fits and `AsnIntegerTooLarge`
// when it does not; `integer_bytes_at` answers the content whatever its
// length.
//
// UTCTime has a two-digit year: 50 and above is 19xx, below 50 is 20xx
// (RFC 5280 section 4.1.2.5.1).  Both time types answer calendar-nv's
// `CivilDateTime`, so the rule is applied once, here.  DER requires the
// time in UTC, with a `Z` (X.690 section 11.7).  A local offset is legal
// BER and means a certificate expires at a moment that depends on where
// it is read, so `AsnTimeNotUtc` refuses it whatever the limits say.
// The seconds are required, as DER requires them.

use std.bytes
use std.str
use asn1read
use asn1oid
use civil

// ── reading ─────────────────────────────────────────────────────────

// The BOOLEAN at `off`.
//
// DER admits `0xff` for true and `0x00` for false and nothing else;
// BER reads any non-zero byte as true, and `ber_tolerant` is the
// switch.  `AsnBadBoolean` names the byte.
pub fn boolean_at(src: Bytes, off: Int, limits: AsnLimits) -> Result<Bool, AsnDecodeError> []
    let c = asn1read.expect_at(src, off, 1, limits)!
    if c.len != 1
        return Err(AsnBadBoolean(c.off, -1))
    let b = byte(src, c.off)
    if b == 0
        return Ok(false)
    if b != 255 and not limits.ber_tolerant
        return Err(AsnBadBoolean(c.off, b))
    Ok(true)

// The INTEGER at `off`, as a number.
//
// `AsnIntegerTooLarge` when the content is longer than a novo-lang
// `Int` can hold — which is not a fault in the document, so the
// refusal names the length and `integer_bytes_at` is the way through.
//
// ```novo
// use std.bytes
// use asn1read
// use asn1univ
//
// fn main() [io]
//     // `02 01 07` — the INTEGER 7.
//     let der = bytes.from_hex("020107") ?? bytes.zeros(0)
//     match asn1univ.integer_at(der, 0, asn1read.default_limits())
//         Ok(n)  => println("${n}")   // 7
//         Err(e) => println(e.message())
// ```
pub fn integer_at(src: Bytes, off: Int, limits: AsnLimits) -> Result<Int, AsnDecodeError> []
    let c = integer_content(src, off, limits)!
    // A redundant leading byte, which only BER leaves in, does not count
    // against the width.
    var start = c.off
    let end = c.off + c.len
    while end - start > 1 and redundant(byte(src, start), byte(src, start + 1))
        start = start + 1
    if end - start > 8
        return Err(AsnIntegerTooLarge(off, c.len))
    let first = byte(src, start)
    var v = if first >= 128
        first - 256
    else
        first
    for i in start + 1..end
        v = v * 256 + byte(src, i)
    Ok(v)

// The INTEGER at `off`, as its content bytes: two's complement,
// big-endian, leading zero included when there is one.
//
// What a certificate's serial number and an RSA modulus need.  The
// leading zero is not noise — it is what keeps a positive number from
// looking negative, and a caller that stripped it and re-encoded would
// produce different bytes and a different signature.
pub fn integer_bytes_at(src: Bytes, off: Int, limits: AsnLimits) -> Result<Bytes, AsnDecodeError> []
    let c = integer_content(src, off, limits)!
    Ok(asn1read.span_bytes(src, c))

// A BIT STRING: how many bits of the last byte are padding, and the
// bytes.
pub struct AsnBitString
    // `0 ..= 7`.  The first content byte of the encoding.
    unused_bits: Int
    // The bits, packed most significant first, padding included in the
    // last byte.
    data: Bytes

// The BIT STRING at `off`.
//
// `AsnBadBitString` for an unused count above 7, or a non-zero count on
// empty content.
pub fn bit_string_at(src: Bytes, off: Int,
                     limits: AsnLimits) -> Result<AsnBitString, AsnDecodeError> []
    let c = asn1read.expect_at(src, off, 3, limits)!
    if c.len == 0
        return Err(AsnBadBitString(c.off, -1))
    let unused = byte(src, c.off)
    if unused > 7 or c.len == 1 and unused != 0
        return Err(AsnBadBitString(c.off, unused))
    Ok(AsnBitString { unused_bits: unused, data: bytes.slice(src, c.off + 1, c.off + c.len) })

// How many bits a BIT STRING holds: eight per byte, less the unused
// count.
pub fn bit_count(b: AsnBitString) -> Int []
    let n = bytes.len(b.data) * 8 - b.unused_bits
    if n < 0
        0
    else
        n

// Whether bit `i` is set, counting from the most significant bit of the
// first byte — which is bit 0, and is the numbering every ASN.1 module
// uses.
//
// False for an index past the end rather than a refusal: a KeyUsage
// extension may be two bits long and a caller asking about bit 5 wants
// "not set", not an error.
pub fn bit_at(b: AsnBitString, i: Int) -> Bool []
    if i < 0 or i >= bit_count(b)
        return false
    ((byte(b.data, i / 8) >> (7 - i % 8)) & 1) == 1

// The OCTET STRING at `off`, as its content.
pub fn octet_string_at(src: Bytes, off: Int, limits: AsnLimits) -> Result<Bytes, AsnDecodeError> []
    Ok(asn1read.span_bytes(src, asn1read.expect_at(src, off, 4, limits)!))

// The NULL at `off`, answering how many bytes it occupied: 2.
//
// A length rather than nothing, so a caller walking a structure by
// offset can step past it the same way it steps past everything else.
// `AsnNullWithContent` for a NULL with a length that is not zero.
pub fn null_at(src: Bytes, off: Int, limits: AsnLimits) -> Result<Int, AsnDecodeError> []
    let c = asn1read.expect_at(src, off, 5, limits)!
    if c.len != 0
        return Err(AsnNullWithContent(off, c.len))
    Ok(c.off - off)

// The OBJECT IDENTIFIER at `off`.
pub fn oid_at(src: Bytes, off: Int, limits: AsnLimits) -> Result<AsnOid, AsnDecodeError> []
    let c = asn1read.expect_at(src, off, 6, limits)!
    match asn1oid.decode(asn1read.span_bytes(src, c))
        Ok(o)  => Ok(o)
        Err(e) => Err(AsnBadOid(c.off + asn1err.decode_offset(e)))

// The UTF8String at `off`.
//
// `AsnBadStringBytes` for content that is not valid UTF-8, naming the
// byte.
pub fn utf8_string_at(src: Bytes, off: Int, limits: AsnLimits) -> Result<Str, AsnDecodeError> []
    let c = asn1read.expect_at(src, off, 12, limits)!
    check_utf8(src, c)!
    Ok(bytes.to_str(asn1read.span_bytes(src, c)))

// The PrintableString at `off`.
//
// The alphabet is restricted and is not the one most people guess: A-Z,
// a-z, 0-9, space, and `' ( ) + , - . / : = ?` — no `@`, no `_`, no
// `*`.  Every real certificate has a subject that could not be a
// PrintableString for exactly that reason, which is why UTF8String won.
pub fn printable_string_at(src: Bytes, off: Int,
                           limits: AsnLimits) -> Result<Str, AsnDecodeError> []
    let c = asn1read.expect_at(src, off, 19, limits)!
    for i in c.off..c.off + c.len
        if not printable(byte(src, i))
            return Err(AsnBadStringBytes(i, byte(src, i)))
    Ok(bytes.to_str(asn1read.span_bytes(src, c)))

// The IA5String at `off`: ASCII, `0x00 ..= 0x7f`.
//
// What an email address and a DNS name in a subject alternative name
// are written in.
pub fn ia5_string_at(src: Bytes, off: Int, limits: AsnLimits) -> Result<Str, AsnDecodeError> []
    let c = asn1read.expect_at(src, off, 22, limits)!
    for i in c.off..c.off + c.len
        if byte(src, i) > 127
            return Err(AsnBadStringBytes(i, byte(src, i)))
    Ok(bytes.to_str(asn1read.span_bytes(src, c)))

// Any of the three string types at `off`, whichever it is.
//
// A tag that is none of the three is `AsnUnexpectedTag` naming 12, the
// UTF8String.  What a name parser calls: an X.500 attribute value is a
// `DirectoryString`, which is UTF8String today and PrintableString in
// anything old, and a parser that demanded one would fail on half the
// certificates in the world.
pub fn any_string_at(src: Bytes, off: Int, limits: AsnLimits) -> Result<Str, AsnDecodeError> []
    let t = asn1read.peek_tag_at(src, off, limits)!
    if t.class == AsnUniversal and t.number == 19
        return printable_string_at(src, off, limits)
    if t.class == AsnUniversal and t.number == 22
        return ia5_string_at(src, off, limits)
    utf8_string_at(src, off, limits)

// The UTCTime at `off`, as a civil date and time.
//
// `YYMMDDHHMMSSZ`, and the two-digit year resolves by the sliding
// window: 50 and above is 19xx, below 50 is 20xx.  `AsnTimeNotUtc`
// when there is no `Z`, which `ber_tolerant` does not lift.
//
// ```novo
// use std.bytes
// use asn1read
// use asn1univ
// use civil
//
// fn main() [io]
//     // `17 0d 32 36 30 39 31 31 30 30 30 30 30 30 5a` —
//     // UTCTime "260911000000Z".
//     let der = bytes.from_hex("170d3236303931313030303030305a") ?? bytes.zeros(0)
//     match asn1univ.utc_time_at(der, 0, asn1read.default_limits())
//         Ok(t)  => println("${t.date.year}")   // 2026
//         Err(e) => println(e.message())
// ```
pub fn utc_time_at(src: Bytes, off: Int,
                   limits: AsnLimits) -> Result<CivilDateTime, AsnDecodeError> []
    let c = asn1read.expect_at(src, off, 23, limits)!
    let text = time_text(src, c)!
    if str.len(text) != 13 or not digits(text, 0, 12)
        return Err(AsnBadTime(c.off, text))
    let year = utc_year(number(text, 0, 2))
    civil_of(c.off, text, year, 2, "")

// The GeneralizedTime at `off`, as a civil date and time.
//
// `YYYYMMDDHHMMSSZ`, with an optional fraction of a second after a `.`.
// DER requires the fraction to have no trailing zero, and to be absent
// when it would be zero; anything else is `AsnBadTime`.  Digits past
// the ninth are dropped, because the time holds nanoseconds.  What a
// certificate valid past 2049 must use.
pub fn generalized_time_at(src: Bytes, off: Int,
                           limits: AsnLimits) -> Result<CivilDateTime, AsnDecodeError> []
    let c = asn1read.expect_at(src, off, 24, limits)!
    let text = time_text(src, c)!
    let n = str.len(text)
    if n < 15 or not digits(text, 0, 14)
        return Err(AsnBadTime(c.off, text))
    // DER: a fraction is `.` and digits with no trailing zero, and no
    // fraction at all when it would be zero.
    var fraction = ""
    if n > 15
        fraction = str.slice(text, 15, n - 1)
        let ok = str.byte_at_or(text, 14, 0) == '.' and n > 16 and digits(text, 15, n - 1)
            and str.byte_at_or(text, n - 2, 0) != '0'
        if not ok
            return Err(AsnBadTime(c.off, text))
    civil_of(c.off, text, number(text, 0, 4), 4, fraction)

// Either time type at `off`, whichever it is.
//
// What a certificate's `notBefore` and `notAfter` are read with: RFC
// 5280 says each is a CHOICE of the two, chosen by the year.
pub fn any_time_at(src: Bytes, off: Int,
                   limits: AsnLimits) -> Result<CivilDateTime, AsnDecodeError> []
    let t = asn1read.peek_tag_at(src, off, limits)!
    if t.class == AsnUniversal and t.number == 24
        return generalized_time_at(src, off, limits)
    utc_time_at(src, off, limits)

// The children of the SEQUENCE at `off`, as whole-value spans.
//
// `AsnUnexpectedTag` when the value is not a SEQUENCE.
pub fn sequence_at(src: Bytes, off: Int, limits: AsnLimits) -> Result<[AsnSpan], AsnDecodeError> []
    asn1read.expect_at(src, off, 16, limits)!
    asn1read.children_at(src, off, limits)

// The children of the SET at `off`.
//
// A SET's order is not semantically significant, and `set_of_at` is the
// one that checks DER's ordering rule.
pub fn set_at(src: Bytes, off: Int, limits: AsnLimits) -> Result<[AsnSpan], AsnDecodeError> []
    asn1read.expect_at(src, off, 17, limits)!
    asn1read.children_at(src, off, limits)

// The children of the SET OF at `off`, with DER's ordering rule
// applied.
//
// DER requires the elements to be in ascending order of their own
// encodings, so that one set of values has one encoding.
// `AsnSetOfNotSorted` when they are not, and `ber_tolerant` accepts it
// — which is safe only when no signature is being checked over the
// bytes.
pub fn set_of_at(src: Bytes, off: Int, limits: AsnLimits) -> Result<[AsnSpan], AsnDecodeError> []
    let kids = set_at(src, off, limits)!
    if not limits.ber_tolerant
        for i in 1..list.len(kids)
            let before = bytes.to_hex(asn1read.span_bytes(src, kids[i - 1]))
            let here = bytes.to_hex(asn1read.span_bytes(src, kids[i]))
            if here < before
                return Err(AsnSetOfNotSorted(kids[i].off))
    Ok(kids)

// ── the alphabets, as predicates ────────────────────────────────────

// Whether every character is one PrintableString allows.
//
// Published because a caller building a certificate request has to
// choose between PrintableString and UTF8String, and the choice is
// exactly this question.
//
// ```novo
// use asn1univ
//
// fn main() [io]
//     let a = asn1univ.is_printable_string("Acme Ltd")
//     let b = asn1univ.is_printable_string("acme@example.com")
//     println("${a} ${b}")   // true false
// ```
pub fn is_printable_string(s: Str) -> Bool []
    for i in 0..str.len(s)
        if not printable(str.byte_at_or(s, i, 0))
            return false
    true

// Whether every byte is `0x00 ..= 0x7f`.
pub fn is_ia5_string(s: Str) -> Bool []
    for i in 0..str.len(s)
        if str.byte_at_or(s, i, 0) > 127
            return false
    true

// The two-digit year a UTCTime's `yy` stands for: `yy + 1900` at 50 and
// above, `yy + 2000` below it.
//
// Named as a function because it is the rule the type is famous for,
// and because a test that pins it is worth more than a comment.
//
// ```novo
// use asn1univ
//
// fn main() [io]
//     let a = asn1univ.utc_year(49)
//     let b = asn1univ.utc_year(50)
//     println("${a} ${b}")   // 2049 1950
// ```
pub fn utc_year(yy: Int) -> Int []
    if yy >= 50
        1900 + yy
    else
        2000 + yy

// ── the parts the readers above share ───────────────────────────────

// The byte at `i`, or -1 outside the buffer.
fn byte(src: Bytes, i: Int) -> Int []
    bytes.byte_at(src, i) ?? -1

// Whether a first INTEGER content byte and the one after it make the
// first redundant: `00` before a byte below `0x80`, or `ff` before one
// at or above it.
fn redundant(first: Int, second: Int) -> Bool []
    first == 0 and second < 128 or first == 255 and second >= 128

// The content of the INTEGER at `off`, checked for DER's shortest form.
fn integer_content(src: Bytes, off: Int, limits: AsnLimits) -> Result<AsnSpan, AsnDecodeError> []
    let c = asn1read.expect_at(src, off, 2, limits)!
    if c.len == 0
        return Err(AsnTruncated(c.off, 1))
    if c.len > 1 and redundant(byte(src, c.off), byte(src, c.off + 1)) and not limits.ber_tolerant
        return Err(AsnNonMinimalInteger(c.off))
    Ok(c)

// PrintableString's alphabet (X.680 section 41.4): letters, digits,
// space, and `' ( ) + , - . / : = ?`.
fn printable(b: Int) -> Bool []
    let letter = b >= 'A' and b <= 'Z' or b >= 'a' and b <= 'z'
    let digit = b >= '0' and b <= '9'
    letter or digit or b == ' ' or b == 39 or b == '(' or b == ')' or b == '+' or b == ','
        or b == '-' or b == '.' or b == '/' or b == ':' or b == '=' or b == '?'

// Check that a span is UTF-8 (RFC 3629): no overlong form, no
// surrogate, nothing above U+10FFFF.
fn check_utf8(src: Bytes, c: AsnSpan) -> Result<Unit, AsnDecodeError> []
    var i = c.off
    let end = c.off + c.len
    loop
        if i >= end
            break
        let b = byte(src, i)
        let n = utf8_width(b)
        if n == 0 or i + n > end
            return Err(AsnBadStringBytes(i, b))
        if n > 1
            let b1 = byte(src, i + 1)
            let lo = if b == 224
                160
            else
                if b == 240
                    144
                else
                    128
            let hi = if b == 237
                159
            else
                if b == 244
                    143
                else
                    191
            if b1 < lo or b1 > hi
                return Err(AsnBadStringBytes(i + 1, b1))
            for k in i + 2..i + n
                if byte(src, k) < 128 or byte(src, k) > 191
                    return Err(AsnBadStringBytes(k, byte(src, k)))
        i = i + n
    Ok()

// How many bytes a UTF-8 sequence starting with `b` occupies, and 0
// for a byte no sequence starts with.
fn utf8_width(b: Int) -> Int []
    if b < 128
        return 1
    if b >= 194 and b <= 223
        return 2
    if b >= 224 and b <= 239
        return 3
    if b >= 240 and b <= 244
        return 4
    0

// A time value's text, refused when it does not end in `Z`.
fn time_text(src: Bytes, c: AsnSpan) -> Result<Str, AsnDecodeError> []
    for i in c.off..c.off + c.len
        if byte(src, i) > 127
            return Err(AsnBadStringBytes(i, byte(src, i)))
    let text = bytes.to_str(asn1read.span_bytes(src, c))
    if not str.ends_with(text, "Z")
        return Err(AsnTimeNotUtc(c.off))
    Ok(text)

// Whether bytes `[from, to)` of the text are all decimal digits.
fn digits(text: Str, from: Int, to: Int) -> Bool []
    for i in from..to
        let b = str.byte_at_or(text, i, 0)
        if b < '0' or b > '9'
            return false
    true

// The decimal number in bytes `[from, from + width)` of the text.
fn number(text: Str, from: Int, width: Int) -> Int []
    var v = 0
    for i in from..from + width
        v = v * 10 + str.byte_at_or(text, i, '0') - '0'
    v

// The civil date and time a checked time text names: the year already
// read, then month, day, hour, minute and second from byte `at`, and
// the fraction's digits.
fn civil_of(off: Int, text: Str, year: Int, at: Int,
            fraction: Str) -> Result<CivilDateTime, AsnDecodeError> []
    var nano = 0
    for i in 0..9
        nano = nano * 10 + (if i < str.len(fraction) then str.byte_at_or(fraction, i, '0') - '0' else 0)
    match civil.date(year, number(text, at, 2), number(text, at + 2, 2))
        Err(_)  => Err(AsnBadTime(off, text))
        Ok(day) =>
            match civil.time_of(number(text, at + 4, 2), number(text, at + 6, 2), number(text, at + 8, 2), nano)
                Ok(time) => Ok(civil.datetime(day, time))
                Err(_)   => Err(AsnBadTime(off, text))
