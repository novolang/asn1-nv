@test
fn test_ec_cert_fields_match_openssl_x509()
    match asn1pkix.parse_certificate(ec_cert(), asn1read.default_limits())
        Err(e) => test.fail(e.message())
        Ok(c)  =>
            test.assert_eq(c.version, 3)
            test.assert_eq(trimmed(bytes.to_hex(c.serial)), trimmed("6c3d238eed41e9b1c0ca154d9cbd2297774baf08"))
            test.assert_eq(asn1pkix.name_text(c.subject), "CN=example.com,OU=Research\\, North,O=Acme Ltd,C=GB")
            test.assert_eq(asn1pkix.name_text(c.issuer), "CN=example.com,OU=Research\\, North,O=Acme Ltd,C=GB")
            test.assert(same(c.not_before, instant(2026, 9, 27, 15, 31, 30)))
            test.assert(same(c.not_after, instant(2027, 11, 1, 15, 31, 30)))
            test.assert_eq(c.tbs.off, 4)
            test.assert_eq(c.tbs.len, 527)
            test.assert(asn1pkix.algorithms_agree(c))
            test.assert(asn1pkix.names_encode_equal(ec_cert(), c.subject, ec_cert(), c.issuer))
            test.assert_eq(dns_of(c), ["example.com", "www.example.com"])
            test.assert_eq(asn1pkix.unknown_critical_extensions(c).len(), 0)
            match asn1pkix.basic_constraints(c, asn1read.default_limits())
                Ok(Some(b)) =>
                    test.assert(b.is_ca)
                    test.assert_eq(b.path_len, 1)
                _           => test.fail("basicConstraints was not read")
            match asn1pkix.key_usage(c, asn1read.default_limits())
                Ok(Some(k)) =>
                    test.assert(asn1univ.bit_at(k, 0))
                    test.assert(asn1univ.bit_at(k, 5))
                    test.assert(not asn1univ.bit_at(k, 1))
                _           => test.fail("keyUsage was not read")
            match asn1pkix.ext_key_usage_oids(c, asn1read.default_limits())
                Ok(os) =>
                    var texts: [Str] = []
                    for o in os
                        list.push(texts, asn1oid.oid_text(o))
                    test.assert_eq(texts, ["1.3.6.1.5.5.7.3.1", "1.3.6.1.5.5.7.3.2"])
                Err(e) => test.fail(e.message())
            match asn1pkix.ec_public_key_point(c.public_key)
                Ok(pt) => test.assert_eq(bytes.to_hex(pt),
                    "0484276fca1d3c1b6b06d7215bfcb7deb3eb2bab441884d23dba8e5c789c13defe10ef378a776f8d02d9982ee3398ad9bfb1c1e8e97e0c263235cc9bd606bb70d2")
                Err(e) => test.fail(e.message())
            match asn1pkix.signature_bytes(c)
                Ok(sig) =>
                    match asn1pkix.ecdsa_signature_rs(sig, 32, asn1read.default_limits())
                        Ok(p)  =>
                            test.assert_eq(bytes.to_hex(p.r),
                                "f52d4fa889bfbb227c488dfcd08f4953810c88318bf568fac1de56abf3627f9f")
                            test.assert_eq(bytes.to_hex(p.s),
                                "379ee21fc5a7d37c8597e11d7e5d2e6bdaea6ea2837ab2b95c68e16c8b53e656")
                            test.assert_eq(hex_of(asn1pkix.ecdsa_signature_der(p.r, p.s)), bytes.to_hex(sig))
                        Err(e) => test.fail(e.message())
                Err(e)  => test.fail(e.message())

@test
fn test_ed_cert_fields_match_openssl_x509()
    match asn1pkix.parse_certificate(ed_cert(), asn1read.default_limits())
        Err(e) => test.fail(e.message())
        Ok(c)  =>
            test.assert_eq(c.version, 3)
            test.assert_eq(trimmed(bytes.to_hex(c.serial)), trimmed("69666c07bf9a6bf8e12138cf8082f758cae51c9a"))
            test.assert_eq(asn1pkix.name_text(c.subject), "O=Acme Ltd,CN=device-7")
            test.assert_eq(asn1pkix.name_text(c.issuer), "O=Acme Ltd,CN=device-7")
            test.assert(same(c.not_before, instant(2026, 9, 27, 15, 31, 30)))
            test.assert(same(c.not_after, instant(2126, 9, 3, 15, 31, 30)))
            test.assert_eq(c.tbs.off, 4)
            test.assert_eq(c.tbs.len, 314)
            test.assert(asn1pkix.algorithms_agree(c))
            test.assert(asn1pkix.names_encode_equal(ed_cert(), c.subject, ed_cert(), c.issuer))
            test.assert_eq(dns_of(c), ["device-7.example.com"])
            match asn1pkix.ed25519_public_key(c.public_key)
                Ok(k)  => test.assert_eq(bytes.to_hex(k),
                    "b8c7e821125324b75fff7fad889e55fe5a974e64f7f73f2b99b3ad771c804903")
                Err(e) => test.fail(e.message())

@test
fn test_the_keys_match_openssl_pkey_and_write_back_byte_for_byte()
    let lim = asn1read.default_limits()
    match asn1pkix.parse_spki(ec_spki(), lim)
        Ok(k)  => test.assert_eq(hex_of(asn1pkix.write_spki(k)), bytes.to_hex(ec_spki()))
        Err(e) => test.fail(e.message())
    match asn1pkix.parse_spki(ed_spki(), lim)
        Ok(k)  => test.assert_eq(hex_of(asn1pkix.write_spki(k)), bytes.to_hex(ed_spki()))
        Err(e) => test.fail(e.message())
    match asn1pkix.parse_pkcs8(ec_pkcs8(), lim)
        Ok(k)  =>
            test.assert_eq(hex_of(asn1pkix.write_pkcs8(k)), bytes.to_hex(ec_pkcs8()))
            match asn1pkix.ec_private_key_scalar(k)
                Ok(d)  => test.assert_eq(bytes.to_hex(d),
                    "1e88012bc48293c9367487076015bc34ec376d5d81f3e4a01d090a578ffb5231")
                Err(e) => test.fail(e.message())
        Err(e) => test.fail(e.message())
    match asn1pkix.parse_pkcs8(ed_pkcs8(), lim)
        Ok(k)  =>
            test.assert_eq(hex_of(asn1pkix.write_pkcs8(k)), bytes.to_hex(ed_pkcs8()))
            match asn1pkix.ed25519_seed(k)
                Ok(d)  => test.assert_eq(bytes.to_hex(d),
                    "319279c30bd87722dea6e5c37463483bb0fc95dd611b73469d014011bb726b58")
                Err(e) => test.fail(e.message())
        Err(e) => test.fail(e.message())
