@test
fn test_ec_pkcs8_walks_as_openssl_asn1parse_reads_it()
    test.assert_eq(structure(ec_pkcs8()), ["0:0:3:135:c:u16",
        "3:1:2:1:p:u2",
        "6:1:2:19:c:u16",
        "8:2:2:7:p:u6",
        "17:2:2:8:p:u6",
        "27:1:2:109:p:u4"])

@test
fn test_ec_spki_walks_as_openssl_asn1parse_reads_it()
    test.assert_eq(structure(ec_spki()),
        ["0:0:2:89:c:u16", "2:1:2:19:c:u16", "4:2:2:7:p:u6", "13:2:2:8:p:u6", "23:1:2:66:p:u3"])

